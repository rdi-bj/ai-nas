[Unit]
Description=es-thermald controls the thermal system
After=local-fs.target

[Service]
Type=forking
# Define PID file path (consistent with es-thermald.sh file).
PIDFile=/run/es-thermald-parent.pid
ExecStart=/usr/bin/es-thermald.sh start
ExecStop=/usr/bin/es-thermald.sh stop
Restart=on-failure
RestartSec=5
# Configure log output to journal.
StandardOutput=journal
StandardError=journal
#LogLevelMax=debug
# Kill the entire process group when stopping.
KillMode=control-group

[Install]
WantedBy=multi-user.target
