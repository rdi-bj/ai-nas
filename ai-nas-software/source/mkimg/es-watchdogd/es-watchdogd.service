[Unit]
Description=Eswin Custom Watchdog Daemon
After=local-fs.target

[Service]
Type=forking
# Define PID file path.
PIDFile=/var/run/es-watchdogd.pid
ExecStart=/usr/bin/es-watchdogd.sh start
ExecStop=/usr/bin/es-watchdogd.sh stop
# Configure log output to journal.
StandardOutput=journal
StandardError=journal
User=root
Group=root

[Install]
WantedBy=multi-user.target
