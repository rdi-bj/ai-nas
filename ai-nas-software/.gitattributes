# 行尾规范化：构建脚本与源码必须保持 LF
# 否则在 Windows 上检出后被转为 CRLF，放到 Linux 构建环境执行会报
#   /bin/bash^M: bad interpreter: No such file or directory

# Shell 脚本
*.sh      text eol=lf
*.bash    text eol=lf
bashrc    text eol=lf

# 构建系统
Makefile  text eol=lf
makefile  text eol=lf
*.mk      text eol=lf
Kconfig   text eol=lf
defconfig text eol=lf
*.config  text eol=lf

# C 源码与设备树（Linux / U-Boot / OpenSBI）
*.c       text eol=lf
*.h       text eol=lf
*.dts     text eol=lf
*.dtsi    text eol=lf

# systemd / udev 配置
*.rules   text eol=lf
*.service text eol=lf
*.preset  text eol=lf
*.conf    text eol=lf

# 二进制固件与可执行工具：禁止任何换行转换
*.bin     binary
*.hcd     binary
*.blob    binary
*.dtb     binary
es-thermald          binary
es-watchdogd         binary
es-bmcd              binary
es_clk               binary
brcm_patchram_plus   binary
