*.py[cod]
*.egg-info/
dist/
build/
node_modules/
.venv/
venv/

# ===== 环境变量 / 密钥 / 凭证（严禁入库）=====
.env
.env.*
secrets/
*.pem
*.key
*.p12
credentials.json

# ===== 编辑器 / 操作系统 =====
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ===== 日志 / 临时文件 =====
*.log
tmp/

# ===== 构建输出（SDK 编译产物，体积大且可重建，不入库）=====
output/
images/
*.img
*.ext4
*.cpio
*.tar.gz
*.o
*.ko
*.dtb
vmlinux
System.map
Module.symvers

# ===== 上游源码挂载点（由 git submodule 管理，勿直接放置源码）=====
# 注意：source/firmware 与 source/mkimg 是本项目自有内容，已入库；
#       source/linux、source/uboot、source/opensbi 为 submodule 挂载点。
source/linux/*
source/uboot/*
source/opensbi/*

